# Copy to .env to override compose defaults (dev only).
POSTGRES_PASSWORD=aviro-dev-only
AVIRO_ADMIN_TOKEN=aviro-admin-dev-only
# Send telemetry somewhere: OTEL_EXPORTER=otlp plus an endpoint
# OTEL_EXPORTER=otlp
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-debug:4318
# OTEL_EXPORTER_OTLP_HEADERS=authorization=Bearer%20<ingest-token>
